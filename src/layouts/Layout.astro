---
import {baseData} from "@/data/SiteData.ts"
import Nav from "@/layouts/Nav.astro";
import Footer from "@/layouts/Footer.astro";

import "@/styles/global.css";

const {title = baseData.title, description = baseData.description} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,600&family=JetBrains+Mono&display=swap" rel="stylesheet">
	</head>
	<body>
	<Nav />
	<main>
		<slot />
	</main>
	<Footer />
	</body>
</html>
