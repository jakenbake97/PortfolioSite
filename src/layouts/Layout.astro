---
import {baseData} from "@/data/SiteData.ts"
import Footer from "@/layouts/Footer.astro";

import "@/styles/global.css";
import Header from "@/layouts/Header.astro";

const {title = baseData.title, description = baseData.description} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Jake Pigg Portfolio</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,600&family=JetBrains+Mono&display=swap" rel="stylesheet">
	</head>
	<body>
	<Header />
	<main class="container">
		<slot />
	</main>
	<Footer />
	</body>
</html>
