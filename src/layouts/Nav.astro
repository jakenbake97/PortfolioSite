---
const navData = [
	{ label: "Home", href: "/" },
	{ label: "Projects", href: "/projects" },
	{ label: "Contact", href: "/contact" },
];
---
<nav>
    <ul>
        {navData.map((item) => {
            return <li><a href={item.href} class="btn primary">{item.label}</a></li>
        })}
    </ul>
</nav>