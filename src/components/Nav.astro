---
const currentPath = Astro.url.pathname;

const navData = [
	{ label: "Home", href: "/", path: "/" },
	{ label: "Projects", href: "/#projects", path: "/projects" },
	{ label: "Past Work", href: "/#past-work", path: "/past-work" },
];
---
<nav class="site-nav" aria-label="Main navigation">
    <ul class="site-nav-list">
        {navData.map((item) => {
            const isActive = item.href === "/" ? currentPath === "/" : currentPath.startsWith(item.path);
            return (
                    <li><a href={item.href}
                           class:list={["site-nav-link", isActive ? "site-nav-link--active" : ""]}
                           aria-current={isActive ? "page" : undefined}>
                        {item.label}</a>
                    </li>
            )
        })}
    </ul>
</nav>