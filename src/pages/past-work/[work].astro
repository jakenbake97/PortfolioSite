---
import {getCollection, render} from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Image from "astro/components/Image.astro";
import Sidebar from "@/components/Sidebar.astro";

export async function getStaticPaths() {
    const pastWorks = await getCollection("pastWork");
    return pastWorks.map(work => ({
        params: {work: work.data.slug},
        props: {work, pastWorks}
    }));
}

const {work, pastWorks} = Astro.props;
const {Content, headings} = await render(work);
const {title, description, thumbnail, chips, slug} = work.data;
const toc = headings.filter(item => item.depth <= 4);
---
<Layout title={title} description={description}>
    <section class="project-banner">
        <Image class="project-banner-image" src={thumbnail} alt="" loading="eager" />
        <div class="project-banner-content">
            <h1 class="project-banner-title">{title}</h1>
            <p class="project-banner-description">{description}</p>
            <div class="chip-list">
                {chips.map(chip => (
                    <span class="chip">{chip}</span>
                ))}
            </div>
        </div>
    </section>
    <div class="project-page">
        <nav class="toc-minimap">
            <ul>
                {toc.map(item => (
                        <li>
                            <a href={`#${item.slug}`} class=`minimap-item minimap-item-${item.depth}`
                               aria-label={item.text} data-heading={item.text} title={item.text}></a>
                        </li>
                ))}
            </ul>
        </nav>
        <Sidebar current={slug}/>
        <article class="project-article">
            <Content />
        </article>
    </div>
</Layout>